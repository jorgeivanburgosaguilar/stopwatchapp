<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <!-- Make a plain `dotnet publish` target 64-bit Windows while requiring the installed
         .NET 10 Desktop Runtime instead of bundling it into a self-contained deployment. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSelfContained>false</PublishSelfContained>
    <Version>1.11.0</Version>

    <!-- AGENTS.md §6 — without this, the SDK appends SourceRevisionId to
         AssemblyInformationalVersionAttribute, which the window title reads verbatim through
         Application.ProductVersion. A git hash is not user-facing version information. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Required by LibraryImportAttribute-based source-generated interop (SYSLIB1062); see
         TrayIconService's DestroyIcon P/Invoke and AGENTS.md §6/§10.1. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- WinForms application configuration (source-generates ApplicationConfiguration.Initialize) -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>

    <!-- Explorer, the pinned taskbar entry, and the published .exe read this; MainForm separately
         loads the EmbeddedResource below for the live window (AGENTS.md §6/§10.3). See
         Assets/NOTICE.md for provenance. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- Analyzers as real build gates -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <!-- Loaded at runtime by MainForm.LoadAppIcon() to set Form.Icon (the title-bar/live-taskbar
         icon) — <ApplicationIcon> above only covers the .exe's own icon, not the running window's. -->
    <EmbeddedResource Include="Assets\app.ico" />
    <!-- Color emoji drawn inline in record/lap rows by IconTextLayout, because GDI text rendering
         cannot paint color font glyphs (AGENTS.md §8.5). Manifest names are
         StopwatchApp.Assets.emoji.<name>.png; see Assets/NOTICE.md for provenance. -->
    <EmbeddedResource Include="Assets\emoji\*.png" />
    <Content
      Include="settings.json"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
