<Project Sdk="Microsoft.NET.Sdk">
  <!--
    S14 (AGENTS.md section 17): a one-off generator for StopwatchApp/Assets/app.ico, run manually
    from the repo root (see the sibling README.md in this folder for the exact command).
    Deliberately NOT referenced by StopwatchApp.slnx: it is not part of the shipped app and must not
    be a build/test gate for the root-level dotnet build/dotnet test commands in AGENTS.md section 4.
    The committed .ico is the artifact; this project exists only so it is re-derivable rather than
    opaque binary.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- SVG.NET (MIT) rasterizes the vendored Fluent System Icons source under vendor/fluent-timer
         (see vendor/fluent-timer/NOTICE.md) into the sized bitmaps app.ico packs. -->
    <PackageReference Include="Svg" Version="3.4.8" />
  </ItemGroup>
  <ItemGroup>
    <!-- Copied beside the built .exe so Program.cs can find them via AppContext.BaseDirectory. -->
    <None Include="vendor\**\*.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
